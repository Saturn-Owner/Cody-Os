# Beispielkonfiguration für die generische CodyOS-Hermes-Integration.
# Keine echten Secrets committen.
CODYOS_HERMES_API_BASE=http://127.0.0.1:8642
CODYOS_HERMES_API_KEY=durch-eigenes-hermes-api-token-ersetzen
CODYOS_HERMES_SESSION_KEY=codyos-home
CODYOS_HERMES_SESSION_TITLE=CodyOS Home
CODYOS_HERMES_TIMEOUT_SECONDS=120
