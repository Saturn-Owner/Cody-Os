# Öffentliche Beispielkonfiguration für das Cody Home Gateway.
# Keine echten Secrets in Git speichern.
CODY_HOME_BIND_HOST=127.0.0.1
CODY_HOME_BIND_PORT=8787
CODY_HOME_PUBLIC_BASE_PATH=/cody-home
CODY_HOME_GATEWAY_HOME=.
CODY_HOME_GATEWAY_STATE=./state

# Generisches Hermes-kompatibles Backend. Für /message und /voice erforderlich.
CODY_HOME_HERMES_API_BASE=http://127.0.0.1:8642
CODY_HOME_HERMES_API_KEY=durch-lokales-backend-token-ersetzen
CODY_HOME_HERMES_SESSION_KEY=cody-home
CODY_HOME_HERMES_SESSION_TITLE=Cody Home

CODY_HOME_PAIRING_TTL_SECONDS=300
CODY_HOME_NONCE_TTL_SECONDS=300
CODY_HOME_MAX_CLOCK_SKEW_SECONDS=30

CODY_HOME_VOICE_ENABLED=true
CODY_HOME_MAX_VOICE_UPLOAD_BYTES=15728640
